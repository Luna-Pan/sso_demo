{
  "name": "sso-web",
  "version": "1.0.0",
  "private": true,
  "description": "SSO business site frontends (one codebase, three branded builds)",
  "scripts": {
    "dev": "vite",
    "dev:a": "vite --mode a",
    "dev:b": "vite --mode b",
    "dev:c": "vite --mode c",
    "build": "tsc -b && vite build",
    "build:a": "vite build --mode a",
    "build:b": "vite build --mode b",
    "build:c": "vite build --mode c",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^5.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}

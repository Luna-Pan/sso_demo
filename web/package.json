{
  "name": "reely-web",
  "version": "1.0.0",
  "private": true,
  "description": "Reely business site frontends (one codebase, three branded builds)",
  "scripts": {
    "dev": "vite",
    "dev:mind": "vite --mode mind",
    "dev:nexus": "vite --mode nexus",
    "dev:train": "vite --mode train",
    "build": "tsc -b && vite build",
    "build:mind": "vite build --mode mind",
    "build:nexus": "vite build --mode nexus",
    "build:train": "vite build --mode train",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^5.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}

# 部署环境变量模板
# 使用方法（服务器上，deploy/ 目录内）：cp .env.example .env，然后替换所有 <...> 占位符
# 此文件包含真实密钥，已被 .gitignore 忽略，不要提交

# ===== 镜像地址（GitHub Actions 构建后推到 GHCR，替换 <owner> 为仓库所有者，全小写）=====
# 例：仓库 github.com/tom/sso_demo → ghcr.io/tom/reely-idp:latest
IMAGE_IDP=ghcr.io/<owner>/reely-idp:latest
IMAGE_BFF=ghcr.io/<owner>/reely-bff:latest

# ===== 对外域名（换成你的实际域名；必须与 DNS 一致，OIDC 注册完全依赖这些值）=====
IDP_ISSUER=https://sso.example.com/auth
IDP_WEB_ORIGIN=https://sso.example.com
SITE_MIND_ORIGIN=https://mind.example.com
SITE_NEXUS_ORIGIN=https://nexus.example.com
SITE_TRAIN_ORIGIN=https://train.example.com

# Mock 联邦登录页面指向 IdP 域名（对接真实 VSO/微信网关后：改 VSO_MODE=real 并配置对应端点）
VSO_MOCK_ORIGIN=https://sso.example.com
WECHAT_MOCK_ORIGIN=https://sso.example.com

# ===== 密钥（用 openssl rand -hex 32 生成，生产必须全部替换）=====
IDP_COOKIE_KEYS=<openssl rand -hex 32>
IDP_ADMIN_TOKEN=<openssl rand -hex 24>

# ===== PostgreSQL =====
PG_USER=reely
PG_PASSWORD=<openssl rand -hex 16>
PG_DATABASE=reely_idp

# ===== 内部连线（固定值，无需修改）=====
REDIS_URL=redis://redis:6379
IDP_INTERNAL_BASE=http://idp:4000

# ============================================================
# 服务器手动部署完整步骤
# ============================================================
# 1. 安装 Docker Engine + compose 插件 和 nginx
# 2. 克隆仓库：git clone <你的仓库地址> /opt/reely
# 3. cd /opt/reely/deploy && cp .env.example .env，编辑填好上面所有值
# 4. （镜像包为私有才需要）服务器登录 GHCR：
#      echo <PAT:read:packages> | docker login ghcr.io -u <github用户名> --password-stdin
#    公开包可跳过；首次发布后可在 GitHub 包页面把 Package 改为 public
# 5. 前端静态文件：GitHub Actions 运行页 → Artifacts → 下载 reely-web-static.zip，
#    解压到 /opt/reely/deploy/web/（得到 mind/ nexus/ train/ 三个目录）
# 6. 启动：cd /opt/reely/deploy && docker compose up -d
# 7. nginx：把本目录 nginx.conf 中的 example.com 替换为你的域名，
#    cp nginx.conf /etc/nginx/conf.d/reely.conf && nginx -t && systemctl reload nginx
# 8. DNS：sso / mind / nexus / train 四条 A 记录指向服务器
#
# 后续更新：Actions 构建新镜像后，服务器上
#   docker compose pull idp bff-mind bff-nexus bff-train && docker compose up -d
#   （重新下载 artifact 并解压覆盖 web/ 即可更新前端）
# ============================================================

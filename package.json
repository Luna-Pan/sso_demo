{
  "name": "sso-demo",
  "private": true,
  "version": "1.0.0",
  "description": "SSO demo platform (IdP + 3 business sites)",
  "workspaces": [
    "idp-server",
    "site-bff",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace idp-server",
    "dev:idp": "npm run dev --workspace idp-server",
    "dev:bff:a": "npm run dev --workspace site-bff -- --site=a",
    "dev:bff:b": "npm run dev --workspace site-bff -- --site=b",
    "dev:bff:c": "npm run dev --workspace site-bff -- --site=c",
    "dev:web:a": "npm run dev --workspace web -- --mode=a",
    "dev:web:b": "npm run dev --workspace web -- --mode=b",
    "dev:web:c": "npm run dev --workspace web -- --mode=c",
    "start:all": "node scripts/dev-all.mjs",
    "check:sso": "node scripts/sso-check.mjs"
  }
}
